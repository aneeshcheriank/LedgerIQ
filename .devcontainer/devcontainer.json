{
  "name": "LedgerIQ Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.testing.pytestEnabled": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "uv venv .venv && (test -f pyproject.toml && uv sync || echo 'No pyproject.toml yet')",
  "remoteUser": "vscode"
}